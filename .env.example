# Public Vite env vars — all VITE_* values are bundled into client JS.
# Never put secrets here.

# API base URL (use /api in local dev with vite proxy, full URL in production)
VITE_API_URL=http://localhost:5000/api

# Google OAuth client ID (public) — same value as API GOOGLE_CLIENT_ID.
# Google Cloud Console → Authorized JavaScript origins:
#   http://localhost:5173 and https://pdf.zuvigo.com
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra SPA client ID (public) — same value as API MICROSOFT_CLIENT_ID.
# Entra → Authentication → SPA redirect URIs:
#   http://localhost:5173 and https://pdf.zuvigo.com
VITE_MICROSOFT_CLIENT_ID=
# Tenant authority. Use "common" for personal + work/school accounts.
VITE_MICROSOFT_TENANT=common

# Canonical site URL for SEO meta tags
VITE_SITE_URL=https://pdf.zuvigo.com

# Optional Sentry DSN for production error tracking
VITE_SENTRY_DSN=
